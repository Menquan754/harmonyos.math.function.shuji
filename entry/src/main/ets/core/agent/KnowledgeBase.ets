export class KnowledgeBase {
  static all(): KbEntry[] {
    return KB;
  }

  /** 关键词检索，返回匹配条目；命中关键词越长，越具体，排得越前 */
  static search(text: string): KbEntry[] {
    if (text.trim().length === 0) {
      return [];
    }
    let low: string = text.toLowerCase();
    for (let i: number = 0; i < SYNONYMS.length; i++) {
      if (low.indexOf(SYNONYMS[i][0]) >= 0) {
        low = low.split(SYNONYMS[i][0]).join(SYNONYMS[i][1]);
      }
    }
    low = low.replace(/\s+/g, '');
    const hits: KbHit[] = [];
    for (let i: number = 0; i < KB.length; i++) {
      const e: KbEntry = KB[i];
      let best: number = 0;
      for (let j: number = 0; j < e.keywords.length; j++) {
        const kw: string = e.keywords[j].toLowerCase();
        if (low.indexOf(kw) >= 0 && kw.length > best) {
          best = kw.length;
        }
      }
      if (best > 0) {
        const h: KbHit = new KbHit();
        h.entry = e;
        h.score = best;
        hits.push(h);
      }
    }
    hits.sort((a: KbHit, b: KbHit): number => b.score - a.score);
    const out: KbEntry[] = [];
    for (let i: number = 0; i < hits.length; i++) {
      out.push(hits[i].entry);
    }
    return out;
  }
}
